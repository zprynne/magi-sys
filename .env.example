# Copy to .env (repo root) and fill in. Every value has a sensible default
# except ANTHROPIC_API_KEY, which is only needed when MAGI_MOCK=0.

# --- Model ------------------------------------------------------------------
# Optional model profile giving each agent its own model, e.g. the all-local
# MLX council (no API key needed): MAGI_MODELS=models/mlx.yaml
MAGI_MODELS=
ANTHROPIC_API_KEY=
MAGI_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
MAGI_EFFORT=medium
MAGI_MAX_TOKENS=8000
# Retry on a substitute model server-side if a safety classifier declines (1/0)
MAGI_REFUSAL_FALLBACK=1

# --- Deliberation -----------------------------------------------------------
MAGI_MAX_ROUNDS=2
# majority | unanimous
MAGI_VERDICT_RULE=majority
# End debate early when every agent already holds the same stance (1/0)
MAGI_EARLY_CONSENSUS=1

# --- Mock mode --------------------------------------------------------------
# 1 = replay saved traces with realistic timing, no API calls
MAGI_MOCK=0
# Playback speed multiplier for mock replays (2.0 = twice as fast)
MAGI_MOCK_SPEED=1.0

# --- Server / paths ---------------------------------------------------------
MAGI_HOST=127.0.0.1
MAGI_PORT=8000
MAGI_CORS_ORIGINS=http://localhost:5173
# Defaults to <repo>/traces and <repo>/personas
MAGI_TRACES_DIR=
MAGI_PERSONAS_DIR=
